APP_NAME="Vente de voiture d'occasion"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Base de données PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/autoplatform?schema=public"
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=autoplatform
DB_USERNAME=user
DB_PASSWORD=password

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# JWT (access + refresh) - générer des secrets robustes avec `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me-access-secret-in-production
JWT_ACCESS_TTL=15
JWT_REFRESH_SECRET=change-me-refresh-secret-in-production
JWT_REFRESH_TTL=10080

# Frontend (CORS + cookie cross-origin)
FRONTEND_URL=http://localhost:3000

# Stockage des images (bascule automatique vers S3 si renseigné, sinon disque local)
FILESYSTEM_DISK=public
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=eu-west-3
S3_PUBLIC_URL=

# SMTP (formulaire de contact)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=alexamb197@gmail.com
MAIL_FROM_NAME="Vente de voiture d'occasion"
